rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection (Profiles)
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Membership Applications (Category A, B, C)
    match /membershipApplications/{appId} {
      allow read, write: if true;
    }

    // 3. Approved Members
    match /members/{memberId} {
      allow read, write: if true;
    }

    // 4. Payments & UTR Records
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 5. Assistance Requests (Beneficiary Help Needs)
    match /assistanceRequests/{requestId} {
      allow read, write: if true;
    }

    // 6. Volunteer Applications
    match /volunteerApplications/{appId} {
      allow read, write: if true;
    }

    // 7. Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 8. Receipts
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // 9. System Config & Counters
    match /systemConfig/{configId} {
      allow read, write: if true;
    }
  }
}
