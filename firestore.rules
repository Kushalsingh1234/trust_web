rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.email == 'admin@trust-app.local') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users collection (Profiles)
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (resource.data.role == 'admin');
    }

    // 2. Usernames reservation index
    match /usernames/{username} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // 3. Payment IDs unique reservation index
    match /paymentIds/{paymentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 4. Sequential Counters (members, receipts)
    match /counters/{counterId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Settings (e.g. settings/payment, settings/trust)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Memberships collection (Unified & Backward compatible)
    match /memberships/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 7. Membership Applications (Active deployed collection)
    match /membershipApplications/{appId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 8. Donations collection
    match /donations/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 9. Payments collection
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 10. Help Requests collection
    match /helpRequests/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 11. Assistance Requests collection
    match /assistanceRequests/{requestId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 12. Volunteers collection
    match /volunteers/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 13. Volunteer Applications collection
    match /volunteerApplications/{appId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 14. Receipts collection
    match /receipts/{receiptId} {
      allow read: if true;
      allow write: if true;
    }

    // 15. Members index
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // 16. Public / Institutional Content
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
